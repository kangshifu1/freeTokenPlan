{
  "schema_version": "free-token-plan/v1",
  "provider_key": "dashscope",
  "provider_name": "DashScope / 阿里云百炼",
  "official_website": "https://www.aliyun.com/product/bailian",
  "console_url": "https://dashscope.console.aliyun.com/",
  "registration": {
    "method": "aliyun_account",
    "requires_phone": true,
    "requires_real_name": true,
    "requires_credit_card": false
  },
  "api": {
    "protocol": "openai_compatible",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "default_model": "qwen-plus",
    "supports_responses_api": true,
    "supports_chat_completions": true,
    "supports_anthropic_compat": true,
    "needs_local_routing": false
  },
  "free_tier": {
    "summary": "New-user free quota and model-specific free windows may apply.",
    "limit_window": "activity-and-model-specific",
    "reset_rule": "official regional policy applies",
    "expires": "check-model-pricing-page"
  },
  "cc_switch": {
    "import_mode": "universal_provider",
    "model_map": [
      {
        "label": "qwen-plus",
        "model": "qwen-plus"
      },
      {
        "label": "qwen-turbo",
        "model": "qwen-turbo"
      }
    ]
  },
  "notes": [
    "One of the best direct options for Chinese mainland users.",
    "Verify current compatible-mode endpoints and free model status before import."
  ]
}
