{
  "schema_version": "free-token-plan/v1",
  "provider_key": "baidu-qianfan",
  "provider_name": "Baidu Qianfan",
  "official_website": "https://cloud.baidu.com/doc/qianfan/s/Imi2rpirg",
  "console_url": "https://console.bce.baidu.com/qianfan/",
  "registration": {
    "method": "baidu_cloud_account",
    "requires_phone": true,
    "requires_real_name": true,
    "requires_credit_card": false
  },
  "api": {
    "protocol": "provider_native_or_compatible_gateway",
    "base_url": "check-current-qianfan-docs",
    "api_key_env": "QIANFAN_API_KEY",
    "default_model": "check-current-free-model",
    "supports_responses_api": false,
    "supports_chat_completions": false,
    "supports_anthropic_compat": false,
    "needs_local_routing": true
  },
  "free_tier": {
    "summary": "New-user token grants are available for multiple models; exact models and validity follow the official Qianfan free-quota page.",
    "limit_window": "new-user-campaign",
    "reset_rule": "campaign rules apply",
    "expires": "about-3-months-or-current-page"
  },
  "cc_switch": {
    "import_mode": "manual_gateway_record",
    "model_map": [
      {
        "label": "current-free-model",
        "model": "check-current-free-model"
      }
    ]
  },
  "notes": [
    "Complete real-name verification before assuming the free quota is available.",
    "Verify current model compatibility and endpoint before importing into CC Switch."
  ]
}
